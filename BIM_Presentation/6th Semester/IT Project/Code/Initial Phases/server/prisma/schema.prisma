generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  fullName          String
  email             String             @unique
  phone             String             @unique
  passwordHash      String
  role              UserRole
  preferredLanguage LanguagePreference
  isPhoneVerified   Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  officeId          String?
  office            GovernmentOffice?  @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@index([officeId])
}

model GovernmentOffice {
  id           String        @id @default(uuid())
  name         String
  description  String
  address      String
  city         String
  district     String
  province     String
  phone        String
  email        String
  openingTime  DateTime
  closingTime  DateTime
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  services     Service[]
  requiredDocs RequiredDocument[]

  @@index([isActive])
}

model Service {
  id             String       @id @default(uuid())
  officeId       String
  nameEn         String
  nameNe         String
  descriptionEn  String
  descriptionNe  String
  category       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  office         GovernmentOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)
  stages         ServiceStage[]

  @@index([officeId])
  @@index([isActive])
}

model ServiceStage {
  id                  String            @id @default(uuid())
  serviceId           String
  nameEn              String
  nameNe              String
  descriptionEn       String
  descriptionNe       String
  stageOrder          Int
  estimatedDurationMin Int
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  service             Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requiredDocuments   ServiceRequiredDocument[]

  @@unique([serviceId, stageOrder])
  @@index([serviceId])
  @@index([isActive])
}

model RequiredDocument {
  id             String   @id @default(uuid())
  nameEn         String
  nameNe         String
  descriptionEn  String
  descriptionNe  String
  documentType   DocumentType
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  stages         ServiceRequiredDocument[]

  @@index([documentType])
  @@index([isActive])
}

model ServiceRequiredDocument {
  id                 String           @id @default(uuid())
  serviceStageId     String
  requiredDocumentId String
  serviceStage       ServiceStage     @relation(fields: [serviceStageId], references: [id], onDelete: Cascade)
  requiredDocument   RequiredDocument @relation(fields: [requiredDocumentId], references: [id], onDelete: Cascade)

  @@unique([serviceStageId, requiredDocumentId])
  @@index([serviceStageId])
  @@index([requiredDocumentId])
}

model OtpVerification {
  id         String   @id @default(uuid())
  userId     String
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  CITIZEN
  STAFF
  ADMIN
}

enum LanguagePreference {
  EN
  NE
}

enum DocumentType {
  CitizenshipCertificate
  ApplicationReceipt
  PassportSizePhoto
  MedicalReport
  PaymentReceipt
  IdentityProof
  AddressProof
  Other
}